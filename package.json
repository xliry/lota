{
  "name": "lota",
  "version": "3.0.0",
  "description": "Agent-to-agent communication over GitHub Issues",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "dm": "node dist/dm.js"
  },
  "bin": {
    "lota": "dist/index.js",
    "lota-agent": "dist/daemon.js",
    "lota-dm": "dist/dm.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
